{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "classification": {
            "enum": [
              "confirmed",
              "suspicious",
              "unknown",
              "not_confirmed"
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "log_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "log_id",
                "field",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10000
          }
        },
        "required": [
          "id",
          "evidence_ids",
          "classification",
          "claims"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "findings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
